#!/usr/bin/env node
/**
 * amq lulas build-sw — generate dist/sw.js from the built site.
 *
 * The simulation has no server state at all: it is an index.html, one bundle and a canvas.
 * So the worker PRECACHES everything `vite build` emitted and serves it cache-first. The
 * file list is only known at build time (hashed names), and the cache name is a hash of
 * that list, so any deploy that changes a byte ships a new cache and drops the old one.
 *
 * Reads dist/, so it must run AFTER `vite build` — `bun run build` chains it, and that is
 * normally the only place it is invoked from.
 *
 * Adapted from `sanremo/amq/amq-sanremo-build-sw`; sanremo's core/optional split is gone
 * because here everything is core. Plain JS on purpose: an `amq` command is an executable
 * with no extension, so node cannot type-strip it.
 */
import { createHash } from 'node:crypto';
import { readdir, readFile, writeFile } from 'node:fs/promises';
import { dirname, join, relative } from 'node:path';
import { fileURLToPath } from 'node:url';

// amq/ sits at the project root, so `..` is lulas/.
const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const DIST = join(ROOT, 'dist');

const files = (await walk(DIST))
  // sw.js caches everything else, not itself; sourcemaps are dead weight offline.
  .filter((path) => path !== 'sw.js' && !path.endsWith('.map'))
  .map((path) => `/${path}`)
  .sort();

// A shell is requested as `/` or `/2014/`, never as `.../index.html`. Cache BOTH
// forms: the directory URL is what a navigation asks for, the file URL is what a
// direct link asks for, and an uncached navigation offline falls through to the
// wrong page.
const urls = files.flatMap((url) =>
  url.endsWith('/index.html') ? [url.slice(0, -'index.html'.length), url] : [url],
);

// Hash the CONTENTS, not just the file list. Vite's own output is hashed in its
// filename, so a list would do for it — but /2014 is copied verbatim under stable
// names, and so is index.html, and a list-derived cache name does not change when
// one of those files does. Everyone would keep the old copy, forever, with no way
// to tell. Cheap here: the whole site is well under a megabyte.
const digest = createHash('sha256');

for (const url of urls) {
  digest.update(url);
  // The folded directory URLs (`/`, `/2014/`) are aliases of a file already
  // hashed under its real name, so there is nothing to read for them.
  if (!url.endsWith('/')) digest.update(await readFile(join(DIST, url.slice(1))));
}

const version = digest.digest('hex').slice(0, 12);

const sw = `/*
 * lulas' service worker — GENERATED by amq/amq-lulas-build-sw, do not edit.
 *
 * Precaches the whole built site so the simulation runs offline once installed. Everything
 * is served cache-first; navigations fall back to the cached shell.
 */
const CACHE = 'lulas-${version}';
const ASSETS = ${JSON.stringify(urls, null, 2)};

// Cache tolerantly: one missing asset must not abort the whole batch.
function cacheAll(cache, urls) {
  return Promise.all(
    urls.map((url) => cache.add(new Request(url, { cache: 'reload' })).catch(() => {})),
  );
}

self.addEventListener('install', (event) => {
  event.waitUntil(
    (async () => {
      const cache = await caches.open(CACHE);
      await cacheAll(cache, ASSETS);
      await self.skipWaiting();
    })(),
  );
});

self.addEventListener('activate', (event) => {
  event.waitUntil(
    (async () => {
      const keys = await caches.keys();
      await Promise.all(keys.filter((k) => k !== CACHE).map((k) => caches.delete(k)));
      await self.clients.claim();
    })(),
  );
});

self.addEventListener('fetch', (event) => {
  const { request } = event;
  if (request.method !== 'GET' || new URL(request.url).origin !== self.location.origin)
    return;

  event.respondWith(
    (async () => {
      const cached = await caches.match(request, { ignoreSearch: true });
      if (cached) return cached;

      try {
        const response = await fetch(request);
        if (response.ok) {
          const cache = await caches.open(CACHE);
          cache.put(request, response.clone());
        }
        return response;
      } catch {
        // Offline and uncached: a navigation still gets a shell so something
        // boots. The NEAREST one -- /2014/anything must never fall back to the
        // current simulation's shell, which is a different program.
        if (request.mode === 'navigate') {
          const [, first] = new URL(request.url).pathname.split('/');
          const nearest = first ? await caches.match(\`/\${first}/\`) : null;
          const shell = nearest || (await caches.match('/'));
          if (shell) return shell;
        }
        throw new Error('offline and not cached');
      }
    })(),
  );
});
`;

await writeFile(join(DIST, 'sw.js'), sw);
console.log(
  `Wrote dist/sw.js — precaching ${urls.length} files (cache lulas-${version})`,
);

async function walk(dir) {
  const entries = await readdir(dir, { withFileTypes: true });
  const out = [];

  for (const entry of entries) {
    const full = join(dir, entry.name);
    if (entry.isDirectory()) out.push(...(await walk(full)));
    else out.push(relative(DIST, full));
  }

  return out;
}
