#!/usr/bin/env node
/**
 * amq lulas build-versions — put every frozen version of the simulation into dist/.
 *
 * - `/2014` — `recover/js-2014`, copied (plain JS, RequireJS at runtime), plus the
 *   missing files and the black-background snippet from versions/ (see versions/README.md).
 * - `/2026` — `versions/2026`, a frozen copy of this project's own sources, bundled
 *   with esbuild and never updated again.
 *
 * The 2018/2020 trees stay in recover/ and are NOT deployed: no species, nothing to
 * watch. `recover/` is never written to. Runs after `vite build` and BEFORE
 * `amq lulas build-sw`, so the service worker precaches this and /2014 works offline.
 *
 * Plain JS on purpose: an `amq` command is an executable with no extension, so
 * node cannot type-strip it.
 */
import { build } from 'esbuild';
import { readFileSync } from 'node:fs';
import { cp, mkdir, readFile, writeFile } from 'node:fs/promises';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

if (['-h', '--help', 'help'].includes(process.argv[2])) {
  const src = readFileSync(fileURLToPath(import.meta.url), 'utf8');
  console.log(src.slice(0, src.indexOf('*/')).split('\n').slice(1).map((l) => l.replace(/^\s*\/?\*+ ?/, '')).join('\n').trim());
  process.exit(0);
}

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const DIST = join(ROOT, 'dist');

const VERSIONS = [
  {
    path: '2014',
    source: 'recover/js-2014',
    // Only what it takes to run. The Gruntfile, karma config, bower.json, the
    // test suite and lib/sinon are archive, not exhibit — and every file copied
    // here is a file the service worker will precache.
    include: ['index.html', 'main.js', 'src'],
    // Files the archived commit is missing; see versions/README.md for where
    // each one comes from and why it is not in recover/.
    patches: [
      ['versions/2014/require.js', 'bower_components/requirejs/require.js'],
      ['versions/2014/ticker.js', 'src/ticker.js'],
    ],
    // Appended to the copied index.html, before </body>. Additions to the
    // deployed page only — the archived one is never edited.
    inject: { into: 'index.html', from: 'versions/2014/on-black.html' },
  },
  {
    path: '2026',
    source: 'versions/2026',
    include: ['index.html'],
    patches: [],
    // Bundled, not copied: it is TypeScript. esbuild only strips the types, and
    // `import.meta.env.PROD` is pinned false so the snapshot never tries to
    // register the service worker — its page lives under /2026/, so it could not
    // claim the root scope anyway, and the root worker already precaches it.
    bundle: { entry: 'src/index.ts', out: 'bundle.js' },
  },
];

for (const version of VERSIONS) {
  const target = join(DIST, version.path);
  await mkdir(target, { recursive: true });

  for (const entry of version.include) {
    await cp(join(ROOT, version.source, entry), join(target, entry), {
      recursive: true,
    });
  }

  if (version.bundle) {
    await build({
      entryPoints: [join(ROOT, version.source, version.bundle.entry)],
      outfile: join(target, version.bundle.out),
      bundle: true,
      format: 'esm',
      target: 'es2020',
      minify: true,
      define: { 'import.meta.env.PROD': 'false' },
      logLevel: 'warning',
    });
  }

  for (const [from, to] of version.patches) {
    await mkdir(dirname(join(target, to)), { recursive: true });
    await cp(join(ROOT, from), join(target, to));
  }

  if (version.inject) {
    const page = join(target, version.inject.into);
    const html = await readFile(page, 'utf8');
    const snippet = await readFile(join(ROOT, version.inject.from), 'utf8');

    if (!html.includes('</body>')) {
      throw new Error(`${version.inject.into} has no </body> to inject into`);
    }

    await writeFile(page, html.replace('</body>', `${snippet}</body>`));
  }

  console.log(
    `Wrote dist/${version.path}/ — ${version.source}` +
      (version.bundle ? `, bundled ${version.bundle.entry}` : '') +
      (version.patches.length ? ` + ${version.patches.length} patched files` : '') +
      (version.inject ? `, ${version.inject.from} injected` : ''),
  );
}
